# Google Gemini API Configuration
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model for interactive architecture generation
# Recommended: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Local development server port (defaults to 3000)
PORT=3000
